Options +FollowSymLinks -Indexes
RewriteEngine On
RewriteBase /

# Force HTTPS + www (single canonical host) — fixes duplicate non-www host
# and hreflang self-reference conflicts (hreflang tags all use www).
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.evisa-card.com%{REQUEST_URI} [L,R=301]

# 301 redirect *.html → clean URL (prevents duplicate-content indexation)
# Uses %{THE_REQUEST} so it matches the original request line and does not
# loop with the internal rewrite below that adds .html when serving files.
# Full absolute target avoids an ugly :443 port appearing in the Location header.
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\s/([^?\s]+)\.html(\?[^\s]*)?\s [NC]
RewriteRule ^ https://www.evisa-card.com/%1 [R=301,L]

# Clean URLs: /visa/france/ → /en/visa-france.html
RewriteRule ^visa/([a-z0-9-]+)/?$ /en/visa-$1.html [L,R=301]
RewriteRule ^fr/visa/([a-z0-9-]+)/?$ /fr/visa-$1.html [L,R=301]
RewriteRule ^es/visa/([a-z0-9-]+)/?$ /es/visa-$1.html [L,R=301]
RewriteRule ^pt/visa/([a-z0-9-]+)/?$ /pt/visa-$1.html [L,R=301]

# Remove .html extension — root pages
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^/]+)/?$ $1.html [L]

# Remove .html extension — all 10 language subdirs
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(en|fr|es|pt|zh|th|ru|ar|ja|ko)/(.+?)/?$ /$1/$2.html [L]

# 301 Redirects — old URLs / restructuration
# Si tu renommes une page, ajoute ici : Redirect 301 /old-url /new-url

# Anciens slugs racine → nouvelles URLs en/
Redirect 301 /visa-thailand.html /en/visa-thailand.html
Redirect 301 /visa-india.html /en/visa-india.html
Redirect 301 /visa-france.html /en/visa-france.html
Redirect 301 /visa-germany.html /en/visa-germany.html
Redirect 301 /visa-japan.html /en/visa-japan.html
Redirect 301 /visa-usa.html /en/visa-usa.html
Redirect 301 /visa-canada.html /en/visa-canada.html
Redirect 301 /visa-australia.html /en/visa-australia.html
Redirect 301 /visa-spain.html /en/visa-spain.html
Redirect 301 /visa-italy.html /en/visa-italy.html
Redirect 301 /visa-netherlands.html /en/visa-netherlands.html
Redirect 301 /visa-belgium.html /en/visa-belgium.html
Redirect 301 /visa-portugal.html /en/visa-portugal.html
Redirect 301 /visa-greece.html /en/visa-greece.html
Redirect 301 /visa-switzerland.html /en/visa-switzerland.html
Redirect 301 /visa-austria.html /en/visa-austria.html
Redirect 301 /visa-vietnam.html /en/visa-vietnam.html
Redirect 301 /visa-indonesia.html /en/visa-indonesia.html
Redirect 301 /visa-malaysia.html /en/visa-malaysia.html
Redirect 301 /visa-singapore.html /en/visa-singapore.html
Redirect 301 /visa-philippines.html /en/visa-philippines.html
Redirect 301 /visa-cambodia.html /en/visa-cambodia.html
Redirect 301 /visa-china.html /en/visa-china.html
Redirect 301 /visa-turkey.html /en/visa-turkey.html
Redirect 301 /visa-uae.html /en/visa-uae.html
Redirect 301 /visa-jordan.html /en/visa-jordan.html
Redirect 301 /visa-qatar.html /en/visa-qatar.html
Redirect 301 /visa-brazil.html /en/visa-brazil.html
Redirect 301 /visa-mexico.html /en/visa-mexico.html
Redirect 301 /visa-argentina.html /en/visa-argentina.html
Redirect 301 /visa-colombia.html /en/visa-colombia.html
Redirect 301 /visa-costa-rica.html /en/visa-costa-rica.html
Redirect 301 /visa-croatia.html /en/visa-croatia.html
Redirect 301 /visa-czech-republic.html /en/visa-czech-republic.html
Redirect 301 /visa-poland.html /en/visa-poland.html
Redirect 301 /visa-hungary.html /en/visa-hungary.html
Redirect 301 /visa-sweden.html /en/visa-sweden.html
Redirect 301 /visa-norway.html /en/visa-norway.html
Redirect 301 /visa-denmark.html /en/visa-denmark.html
Redirect 301 /visa-ireland.html /en/visa-ireland.html
Redirect 301 /visa-united-kingdom.html /en/visa-united-kingdom.html
Redirect 301 /visa-romania.html /en/visa-romania.html
Redirect 301 /visa-new-zealand.html /en/visa-new-zealand.html
Redirect 301 /visa-hong-kong.html /en/visa-hong-kong.html
Redirect 301 /visa-taiwan.html /en/visa-taiwan.html
Redirect 301 /visa-sri-lanka.html /en/visa-sri-lanka.html
Redirect 301 /visa-nepal.html /en/visa-nepal.html
Redirect 301 /visa-maldives.html /en/visa-maldives.html

# Error pages
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html

# Cache control for static assets (more aggressive)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/html "access plus 1 day"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType application/pdf "access plus 1 month"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Cache-Control headers
<IfModule mod_headers.c>
    # Cache static assets for 1 year
    <FilesMatch "\.(css|js|jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # HTML files cache for 1 day
    <FilesMatch "\.html$">
        Header set Cache-Control "public, max-age=86400, must-revalidate"
    </FilesMatch>

    # Security Headers
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    # Remove server signature
    Header unset X-Powered-By
    Header unset Server
</IfModule>

# Gzip compression (extended types)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript text/xml text/plain
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml
    AddOutputFilterByType DEFLATE application/atom+xml application/x-font-ttf
    AddOutputFilterByType DEFLATE font/opentype image/svg+xml
</IfModule>

# Brotli compression (if available)
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript
    AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json application/xml
</IfModule>

# Disable ETags (use cache headers instead)
<IfModule mod_headers.c>
    Header unset ETag
</IfModule>
FileETag None

# Prevent access to sensitive files
<FilesMatch "(\.htaccess|\.htpasswd|\.git|\.env|composer\.json|package\.json)">
    Order Allow,Deny
    Deny from all
</FilesMatch>
