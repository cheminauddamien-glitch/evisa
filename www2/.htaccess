Options +FollowSymLinks -Indexes
RewriteEngine On
RewriteBase /

# Force HTTPS + www (single canonical host) — fixes duplicate non-www host
# and hreflang self-reference conflicts (hreflang tags all use www).
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\s([^?\s]+)
RewriteRule ^ https://www.evisa-card.com%1 [L,R=301]

# 410 Gone — pages de demonstration Colorlib supprimees (lot A recovery, 07/09/2026)
# En mod_rewrite et place ICI : la regle generique .html-strip plus bas est
# elle aussi du mod_rewrite et s executerait avant un Redirect mod_alias,
# transformant /blog.html en 301 vers /blog puis 404.
# Motifs EXACTS, sans quantificateur : teste en ligne le 09/09/2026, ce serveur
# n applique pas les motifs contenant /? (^blog/?$ ne matchait ni blog ni blog/),
# alors que les motifs exacts fonctionnent. Les formes /blog/ et /blog-single/
# sont couvertes par la regle de suppression du slash final, plus bas.
RewriteRule ^blog$ - [G,L]
RewriteRule ^blog\.html$ - [G,L]
RewriteRule ^blog-single$ - [G,L]
RewriteRule ^blog-single\.html$ - [G,L]
# Sonde de deploiement : permet de verifier quelle version du .htaccess est en ligne.
RewriteRule ^lot-a-probe-20260908$ - [G,L]

# /en/index would need two hops via the generic index rule (→ /en/ → /) —
# short-circuit it to the root in ONE hop.
RewriteRule ^en/index(?:\.html)?/?$ https://www.evisa-card.com/ [R=301,L]

# 301 /index(.html) → / and /<lang>/index(.html) → /<lang>/ — kills the
# duplicate homepages GSC flags as "Alternate page with proper canonical tag"
# (/zh/index, /ru/index, /ja/index, /ar/index served 200 instead of redirecting).
# Placed BEFORE the generic .html rule so /zh/index.html → /zh/ in ONE hop.
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\s/((?:en|fr|es|pt|zh|th|ru|ar|ja|ko)/)?index(?:\.html)?(?:\?[^\s]*)?\s [NC]
RewriteRule ^ https://www.evisa-card.com/%1 [R=301,L]

# /en/ has no index.html — the English home IS the site root (was returning 403)
RewriteRule ^en/?$ https://www.evisa-card.com/ [R=301,L]

# visa-uk was a meta-refresh stub duplicating visa-united-kingdom — real 301 instead
# (exact match so visa-ukraine is untouched; single hop to the clean URL)
RewriteRule ^(en|fr|es|pt|zh|th|ru|ar|ja|ko)/visa-uk(?:\.html)?/?$ https://www.evisa-card.com/$1/visa-united-kingdom [R=301,L]

# Legacy root slugs /visa-<pays>(.html) → /en/visa-<pays> in ONE hop.
# Replaces the old mod_alias "Redirect 301" block: mod_rewrite's .html-strip
# rule fired first and sent /visa-france.html to /visa-france (404, no root
# file), so the mod_alias rules never matched. This rule runs BEFORE the strip.
RewriteRule ^visa-([a-z0-9-]+?)(?:\.html)?/?$ https://www.evisa-card.com/en/visa-$1 [R=301,L]

# Duplicate legal slugs → canonical localized URLs (Règle #2 : 301 obligatoire)
RewriteRule ^fr/disclaimer(?:\.html)?/?$ https://www.evisa-card.com/fr/mentions-legales [R=301,L]
RewriteRule ^es/disclaimer(?:\.html)?/?$ https://www.evisa-card.com/es/aviso-legal [R=301,L]
RewriteRule ^pt/disclaimer(?:\.html)?/?$ https://www.evisa-card.com/pt/aviso-legal [R=301,L]

# 301 redirect *.html → clean URL (prevents duplicate-content indexation)
# Uses %{THE_REQUEST} so it matches the original request line and does not
# loop with the internal rewrite below that adds .html when serving files.
# Full absolute target avoids an ugly :443 port appearing in the Location header.
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\s/([^?\s]+)\.html(\?[^\s]*)?\s [NC]
RewriteRule ^ https://www.evisa-card.com/%1 [R=301,L]

# Clean URLs: /visa/france/ → /en/visa-france — absolute clean target so the
# legacy path resolves in ONE hop (the old .html target added a second 301).
RewriteRule ^visa/([a-z0-9-]+)/?$ https://www.evisa-card.com/en/visa-$1 [L,R=301]
RewriteRule ^fr/visa/([a-z0-9-]+)/?$ https://www.evisa-card.com/fr/visa-$1 [L,R=301]
RewriteRule ^es/visa/([a-z0-9-]+)/?$ https://www.evisa-card.com/es/visa-$1 [L,R=301]
RewriteRule ^pt/visa/([a-z0-9-]+)/?$ https://www.evisa-card.com/pt/visa-$1 [L,R=301]

# Trailing slash on clean URLs (/en/visa-india/ was a 404) → 301 without slash.
# Directories (/fr/, /es/…) are excluded by the !-d condition.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\s/([^?\s]+?)/(\?[^\s]*)?\s
RewriteRule ^(.+)/$ https://www.evisa-card.com/%1 [R=301,L]

# Slugs "visa-free-countries-*" traduits par erreur dans les liens (sans visa-, sin visado-,
# sem visto-, 免签-, ไม่ต้องใช้วีซ่า-, без визы-, ビザ免除-, 무비자-, بدون تأشيرة-) -> vrai fichier.
RewriteRule ^(en|fr|es|pt|zh|th|ru|ar|ja|ko)/(?!visa-free-)[^/]+-countries-([a-z-]+-passport)/?$ https://www.evisa-card.com/$1/visa-free-countries-$2 [R=301,L,NE]

# Remove .html extension — root pages
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^/]+)/?$ $1.html [L]

# Remove .html extension — all 10 language subdirs
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(en|fr|es|pt|zh|th|ru|ar|ja|ko)/(.+?)/?$ /$1/$2.html [L]

# 301 Redirects — old URLs / restructuration
Redirect 301 /retirement-visa-guide /en/retirement-visa-guide
# Si tu renommes une page, ajoute ici : Redirect 301 /old-url /new-url


# Anciens slugs racine : couverts par la RewriteRule ^visa-([a-z0-9-]+?) ci-dessus
# (l ancien bloc mod_alias ne matchait jamais — la regle .html-strip passait avant).

# Error pages
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html

# Cache control for static assets (more aggressive)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/html "access plus 1 day"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType application/pdf "access plus 1 month"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Cache-Control headers
<IfModule mod_headers.c>
    # Cache static assets for 1 year
    <FilesMatch "\.(css|js|jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # HTML files cache for 1 day
    <FilesMatch "\.html$">
        Header set Cache-Control "public, max-age=86400, must-revalidate"
    </FilesMatch>

    # Security Headers
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    # Remove server signature
    Header unset X-Powered-By
    Header unset Server
</IfModule>

# Gzip compression (extended types)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript text/xml text/plain
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml
    AddOutputFilterByType DEFLATE application/atom+xml application/x-font-ttf
    AddOutputFilterByType DEFLATE font/opentype image/svg+xml
</IfModule>

# Brotli compression (if available)
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript
    AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json application/xml
</IfModule>

# Disable ETags (use cache headers instead)
<IfModule mod_headers.c>
    Header unset ETag
</IfModule>
FileETag None

# Prevent access to sensitive files
<FilesMatch "(\.htaccess|\.htpasswd|\.git|\.env|composer\.json|package\.json)">
    Order Allow,Deny
    Deny from all
</FilesMatch>
